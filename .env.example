# Copy to .env.local and fill in.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ieagles
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Used once by `npm run create-admin`
ADMIN_EMAIL=
ADMIN_NAME=iEagles Admin
ADMIN_PASSWORD=
