# Copy to .env.local and fill in.
# Local: mongodb://localhost:27017   Atlas: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/ieagle
MONGODB_URI=
MONGODB_DB=ieagle
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# First admin, created by `npm run seed` (or reset with `npm run create-admin`)
ADMIN_EMAIL=
ADMIN_NAME=iEagles Admin
ADMIN_PASSWORD=
